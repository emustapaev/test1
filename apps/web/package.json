{
  "name": "@krunai/web",
  "private": true,
  "version": "0.0.0",
  "description": "Next.js 14 (App Router, output: 'standalone'), локали /en/ и /ru/, определение локали в middleware.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:i18n",
    "build": "next build",
    "lint": "npm run check:i18n && next lint",
